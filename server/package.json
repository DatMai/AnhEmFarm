{
  "name": "@anhemfarm/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && node scripts/dev.mjs",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run db:generate && vitest run",
    "test:integration": "npm run db:generate && vitest run --config vitest.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "admin": "tsx src/cli/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.44.0",
    "busboy": "1.6.0",
    "cookie": "2.0.1",
    "dotenv": "17.3.1",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
