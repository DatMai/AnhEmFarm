    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
